[Unit]
Description=Radicacion capita - worker de consultas SIE
After=network-online.target
Wants=network-online.target

[Service]
User=root
WorkingDirectory=/opt/radicacion/worker
ExecStart=/opt/radicacion/bot/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8092 --workers 1
# horas del bot y del worker en hora de Colombia (el VPS sigue en su zona, que usan otras apps)
Environment=TZ=America/Bogota
Restart=always
RestartSec=5
# Chromium puede usar bastante memoria; el VPS tiene 4 GB compartidos con otras apps
MemoryMax=2G
# margen de archivos abiertos (soportes RIPS, base de datos, sockets)
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
